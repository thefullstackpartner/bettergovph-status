{
  "name": "bettergovph-status",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "functions:dev": "wrangler dev --ip 127.0.0.1 --port 5525 --test-scheduled",
    "build": "npm run build:app",
    "build:app": "tsc -b && tsx scripts/write-ver-to-json.ts && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "db:migrate:local": "node scripts/run-local-sql.mjs supabase/migrations/20261124000000_bgovph_init.sql",
    "db:down:local": "node scripts/run-local-sql.mjs supabase/bgovph_down.sql",
    "import:websites": "tsx scripts/import-bettergov-websites.ts",
    "validate:data": "node scripts/validate-json-schema.js src/data/schema/categories.schema.json \"src/data/categories.json\" && node scripts/validate-json-schema.js src/data/schema/monitors.schema.json \"src/data/monitors/**/*.json\"",
    "check:trigger": "node -e \"fetch('http://127.0.0.1:5525/api/trigger',{method:'POST'}).then(async r=>{console.log(r.status,await r.text());if(!r.ok)process.exit(1)})\"",
    "check:watch": "tsx scripts/local-cron.ts",
    "check:watch:all": "tsx scripts/local-cron.ts --all",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc -b && tsc -p functions/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "cf-typegen": "wrangler types",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "hono": "^4.13.21",
    "lucide-react": "^0.513.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "glob": "^11.0.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^7.1.9",
    "vitest": "^3.1.3",
    "wrangler": "^4.19.1"
  }
}
