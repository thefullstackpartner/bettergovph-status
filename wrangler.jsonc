{
  "name": "bettergovph-status",
  "main": "functions/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *", "0 */6 * * *", "15 16 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/llms.txt",
      "/llms-full.txt",
      "/robots.txt",
      "/sitemap.xml",
      "/status.md",
      "/incidents.rss",
      "/.well-known/*"
    ]
  },
  "queues": {
    "producers": [{ "binding": "CHECK_QUEUE", "queue": "bettergovph-status-checks" }],
    "consumers": [{ "queue": "bettergovph-status-checks", "max_batch_size": 1, "max_retries": 1 }]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2026112401",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "USER_AGENT": "bettergovph-status/1.0 (+https://bettergovph-status.workers.dev/about)",
    "FRESHNESS_STALE_DAYS": "30",
    // Canonical public URL used for absolute links in llms.txt, robots.txt,
    // sitemap.xml and the OpenAPI spec. Empty = use the request's origin.
    "SITE_URL": ""
  },
  "env": {
    "staging": {
      "name": "bettergovph-status-staging",
      "vars": {
        "USER_AGENT": "bettergovph-status/1.0 (+https://bettergovph-status-staging.workers.dev/about)"
      }
    }
  },
  "observability": { "enabled": true }
}
