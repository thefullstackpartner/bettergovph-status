# Copy to .dev.vars for local wrangler dev (never commit .dev.vars)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-or-project-service-role-key
# Set to "true" locally to allow POST /api/trigger without a secret
ALLOW_MANUAL_TRIGGER=true
# Optional: require Authorization: Bearer <TRIGGER_SECRET> on POST /api/trigger
# TRIGGER_SECRET=
